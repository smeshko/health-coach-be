# Coach App backend — CONTAINER environment template (E12·P2).
#
# These are injected as real environment variables at run time
# (`docker run -e VAR=... ` / the orchestrator), NOT baked into the image — `.env*` is
# `.dockerignore`d. A missing REQUIRED var fails the boot fast (`create_app()` validates
# settings at import).
#
# Access posture (ARCHITECTURE §1): one long-lived API token over HTTPS on a private
# network / Tailscale. The container serves plain HTTP on :8000 — TLS termination and the
# private-network/Tailscale boundary live at the EDGE (a reverse proxy / tailnet), not in
# this image.

# --- Required ---
# A long random secret (≥16 chars; placeholder/`replace-me` values are refused).
API_TOKEN=replace-me-with-a-long-random-token
# Point at the mounted volume so the one durable file (+ its -wal/-shm) survives container
# recreation: run with `-v coach-app-data:/data` (a NAMED volume — it inherits the image's
# non-root `app` ownership, so the SQLite/WAL writes succeed). A NAMED volume is recommended;
# a host bind-mount (`-v /host/path:/data`) keeps the host dir's uid, so it must be
# pre-`chown`ed to the container's `app` user or migrate-on-start will fail to create app.db.
APP_DB_PATH=/data/app.db

# --- LLM / coaching (optional; have defaults) ---
MODEL_ID=claude-opus-4-8
CONSTITUTION_VERSION=v1
# The Anthropic key is only needed to GENERATE briefs (not for /health or /probe).
# ANTHROPIC_API_KEY=
# PROFILE_PATH defaults to the image's /app/profile.yaml; override to point at a mounted file.
# PROFILE_PATH=/data/profile.yaml

# --- Observability (optional; E12·P1 Langfuse tracing is a no-op when unset) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
