# Coach App backend — environment configuration.
# Copy to `.env` for local dev (`.env` is gitignored). In deployment these are
# provided as real environment variables. Required vars have no default — the
# app fails fast at startup if they are missing.

# --- Required ---
# The app REFUSES to boot with this placeholder token (it is rejected as an
# example value) — replace it with a real long random secret before running.
API_TOKEN=replace-me-with-a-long-random-token
APP_DB_PATH=./app.db

# --- LLM / coaching ---
MODEL_ID=claude-opus-4-8
CONSTITUTION_VERSION=v1

# --- Observability (optional; wired in E12) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Local testing (default-off; NEVER enable in deployment) ---
# Serve canned briefs from fixtures/briefs/{weekly,daily}.json instead of calling the
# LLM, so POST /brief/weekly + /brief/daily can be exercised manually (curl/Postman/iOS)
# at zero Anthropic cost. With this on, ANTHROPIC_API_KEY is not needed. Edit the JSON
# files to change what the briefs say (validated against the wire models at startup).
# BRIEF_FIXTURES=1
# BRIEF_FIXTURES_DIR=./fixtures/briefs
