# Keep the build context small + secret/DB/corpus-free (E12·P2).
# No secret (.env), no local DB, no read-only build corpus (baseline.db/export.xml),
# no dev-only trees enter the image.

# Virtualenvs + bytecode
.venv/
venv/
__pycache__/
*.pyc

# VCS + tooling + agent state
.git/
.gitignore
.claude/
.pytest_cache/
.ruff_cache/

# Docs / plans / epics (gitignored on-disk artifacts)
docs/
epics/

# Secrets + local config (config is injected at run time via -e)
.env
.env.*

# The single durable DB + its WAL/SHM sidecars (mounted at run time, never baked in)
*.db
*.db-wal
*.db-shm

# The read-only E4 build corpus — a build input, never opened at runtime
baseline.db
export.xml

# Tests + host-side tooling (not needed in the runtime image)
tests/
scripts/

# Container/build files themselves
Dockerfile
.dockerignore
docker-entrypoint.sh

# Misc
.DS_Store
justfile
